import numpy as np
import pandas as pd
from datetime import datetime, timedelta

def generate_vehicle_trajectories(num_vehicles=10, hours=24, area_size=3000):
    """Generate synthetic vehicle trajectory data"""
    
    trajectories = []
    base_time = datetime(2024, 1, 1, 0, 0, 0)
    
    for veh_id in range(num_vehicles):
        # Start from random position
        x = np.random.uniform(0, area_size)
        y = np.random.uniform(0, area_size)
        
        for hour in range(hours):
            for minute in range(0, 60, 5):  # Every 5 minutes
                current_time = base_time + timedelta(hours=hour, minutes=minute)
                
                # Simulate vehicle movement (random walk)
                x += np.random.normal(0, 50)  # 50m std deviation
                y += np.random.normal(0, 50)
                
                # Keep within bounds
                x = np.clip(x, 0, area_size)
                y = np.clip(y, 0, area_size)
                
                # Add some traffic patterns
                speed = np.random.uniform(5, 25)  # km/h
                direction = np.random.uniform(0, 2 * np.pi)
                
                trajectories.append({
                    'vehicle_id': veh_id,
                    'timestamp': current_time,
                    'x_coordinate': x,
                    'y_coordinate': y,
                    'speed': speed,
                    'direction': direction
                })
    
    return pd.DataFrame(trajectories)

