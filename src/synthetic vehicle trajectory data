        # Add edges with dependencies
        for i in range(1, num_nodes):
            # Random number of parents
            num_parents = np.random.randint(1, min(max_out_degree, i) + 1)
            parents = np.random.choice(range(i), num_parents, replace=False)
            
            for parent in parents:
                G.add_edge(parent, i)
        
        # Convert to serializable format
        nodes_data = {node: G.nodes[node] for node in G.nodes()}
        edges_data = list(G.edges())
        
