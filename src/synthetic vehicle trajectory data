def train_trajectory_predictor(processor, file_path):
    """Train the Transformer trajectory predictor"""
    print("Training Transformer trajectory predictor...")
    
    # Process data
    df = processor.load_and_process_data(file_path)
    sequences, targets = processor.create_sequences(df)
    
    # Create dataset and dataloader
    dataset = TrajectoryDataset(sequences, targets)
    dataloader = DataLoader(dataset, batch_size=32, shuffle=True)
    
    # Initialize model
    trajectory_predictor = TransformerTrajectoryPredictor(
        input_dim=10, d_model=512, nhead=8, num_layers=6
    )
    optimizer = optim.Adam(trajectory_predictor.parameters(), lr=1e-5)
    criterion = nn.MSELoss()
    
    # Training loop
    trajectory_predictor.train()
    for epoch in range(10):  # Reduced for demo
        total_loss = 0
        for batch_sequences, batch_targets in dataloader:
            # Reshape for Transformer: (seq_len, batch_size, features)
            batch_sequences = batch_sequences.transpose(0, 1)
            
            optimizer.zero_grad()
            predictions = trajectory_predictor(batch_sequences)
            loss = criterion(predictions, batch_targets.transpose(0, 1))
            loss.backward()
            optimizer.step()
            
            total_loss += loss.item()
        
        if epoch % 2 == 0:
            print(f"Trajectory Epoch {epoch}, Loss: {total_loss/len(dataloader):.4f}")
    
    print("Trajectory predictor training completed!")
    return trajectory_predictor

def train_dvtp_with_data(trajectory_file_path):
    """Main training function with integrated data processing"""
    
    # Initialize data processor
    processor = VehicleTrajectoryProcessor()
    
    # Train trajectory predictor
    trajectory_predictor = train_trajectory_predictor(processor, trajectory_file_path)
    
    # Environment parameters
    num_vehicles = 3
    num_servers = 2
    max_nodes = 20
    state_dim = num_vehicles * max_nodes * 6 + num_vehicles * 2  # Updated state dimension
    
    # Initialize environment with trajectory predictor
    env = DAGEnvironment(num_vehicles, num_servers, max_nodes, trajectory_predictor)
    agent = PPO(state_dim, max_nodes, num_vehicles + num_servers)
    
    # Training parameters
    num_episodes = 1000
    max_steps = 100
    batch_size = 64
    
    # Training metrics
    episode_rewards = []
    moving_avg_rewards = []
    
    print("Starting DVTP training...")
    
    for episode in range(num_episodes):
        state = env.reset()
        episode_reward = 0
        states, actions, log_probs, rewards, values = [], [], [], [], []
        
        for step in range(max_steps):
            # Get action from policy
            action, log_prob, value = agent.get_action(state)
            
            # Execute action
            next_state, reward, done = env.step(action[0], action[1])
            
            # Store transition
            states.append(state)
            actions.append(action)
            log_probs.append(log_prob)
            rewards.append(reward)
            values.append(value)
            
            state = next_state
            episode_reward += reward
            
            if done:
                break
        
        # Calculate returns and advantages
        returns = []
        R = 0
        for r in reversed(rewards):
            R = r + agent.gamma * R
            returns.insert(0, R)
        
        returns = torch.FloatTensor(returns)
        values = torch.FloatTensor(values)
        advantages = returns - values
        
        # Normalize advantages
        advantages = (advantages - advantages.mean()) / (advantages.std() + 1e-8)
        
        # Update policy
        if len(states) >= batch_size:
            loss = agent.update(states, actions, log_probs, returns, advantages)
        
        episode_rewards.append(episode_reward)
        
        # Calculate moving average
        if len(episode_rewards) >= 10:
            moving_avg = np.mean(episode_rewards[-10:])
            moving_avg_rewards.append(moving_avg)
        
        if episode % 100 == 0:
            avg_reward = np.mean(episode_rewards[-100:]) if episode >= 100 else np.mean(episode_rewards)
            print(f"Episode {episode}, Reward: {episode_reward:.2f}, Avg Reward: {avg_reward:.2f}")
    
    print("DVTP training completed!")
    
    # Plot training progress
    plt.figure(figsize=(12, 4))
    
    plt.subplot(1, 2, 1)
    plt.plot(episode_rewards)
    plt.title('Episode Rewards')
    plt.xlabel('Episode')
    plt.ylabel('Reward')
    
    plt.subplot(1, 2, 2)
    plt.plot(moving_avg_rewards)
    plt.title('Moving Average (10 episodes)')
    plt.xlabel('Episode')
    plt.ylabel('Average Reward')
    
    plt.tight_layout()
    plt.savefig('training_progress.png')
    plt.show()
    
    return agent, trajectory_predictor

# Run the complete training pipeline
if __name__ == "__main__":
    trajectory_file_path = "vehicle_trajectories.csv"
    
    try:
        agent, trajectory_predictor = train_dvtp_with_data(trajectory_file_path)
        print("Training completed successfully!")
        
        # Save trained models
        torch.save(agent.policy_net.state_dict(), 'dvtp_policy_net.pth')
        torch.save(trajectory_predictor.state_dict(), 'trajectory_predictor.pth')
        print("Models saved successfully!")
        
    except FileNotFoundError:
        print(f"Error: File {trajectory_file_path} not found.")
        print("Please make sure the vehicle_trajectories.csv file exists in the current directory.")
    except Exception as e:
        print(f"Error during training: {e}")
